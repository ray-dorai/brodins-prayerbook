<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <!-- Exercise name — blackletter, crimson drop-cap feel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">

        <TextView
            android:id="@+id/exerciseName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="23sp"
            android:fontFamily="@font/unifraktur"
            android:textColor="@color/amber"
            android:paddingBottom="4dp" />

        <!-- Rest after each set of this exercise; tap to change -->
        <TextView
            android:id="@+id/restLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="@font/crimson_text"
            android:textStyle="bold"
            android:textColor="@color/set_icon"
            android:background="@drawable/btn_set"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginBottom="5dp"
            android:clickable="true" />
    </LinearLayout>

    <!-- Thin rule under name -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/crimson"
        android:layout_marginBottom="4dp" />

    <!-- What was lifted the last time this exercise came up -->
    <TextView
        android:id="@+id/lastTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:fontFamily="@font/crimson_text"
        android:textStyle="italic"
        android:textColor="@color/text_dim"
        android:paddingBottom="4dp"
        android:visibility="gone" />

    <!-- Sets go here -->
    <LinearLayout
        android:id="@+id/setsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
