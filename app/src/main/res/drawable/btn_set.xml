<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed inverts; selected (set logged / note written) stays filled gold -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="@color/crimson" />
            <corners android:radius="1dp" />
            <solid android:color="@color/amber_glow" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="@color/amber_glow" />
            <corners android:radius="1dp" />
            <solid android:color="@color/amber" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="@color/input_border" />
            <corners android:radius="1dp" />
            <solid android:color="@color/input_bg" />
        </shape>
    </item>
</selector>
