<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed: colours invert (gold fill, red border) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="@color/crimson" />
            <corners android:radius="2dp" />
            <solid android:color="@color/amber" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="@color/amber" />
            <corners android:radius="2dp" />
            <solid android:color="@color/crimson" />
        </shape>
    </item>
</selector>
